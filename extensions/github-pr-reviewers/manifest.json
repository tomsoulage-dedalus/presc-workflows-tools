{
  "manifest_version": 3,
  "name": "GitHub PR Reviewers",
  "version": "2.1.0",
  "description": "Reviewers, assignation, liens Jira et diagnostic a la demande des builds Jenkins en echec.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://api.github.com/*", "https://ci-jenkins.orbis.dedalus.com/*"],
  "options_page": "options.html",
  "action": {
    "default_title": "GitHub PR Reviewers",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["jira-logo.js", "jira.js"],
      "css": ["jira.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["jenkins.js"],
      "css": ["jenkins.css"],
      "run_at": "document_idle"
    }
  ]
}
